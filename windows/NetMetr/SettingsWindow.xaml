<Window x:Class="NetMetr.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetMetr - Settings &amp; Usage History"
        Height="560" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="{DynamicResource AppFont}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Modern Button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="⚡" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="TxtHeaderTitle" Text="NetMetr Settings" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtHeaderSub" Text="Real-time Network Monitor &amp; Data Tracker" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Tabs Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: General -->
            <TabItem x:Name="TabGeneral" Header="⚙ عمومی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Language Card -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtLblLangTitle" Text="زبان برنامه (Language):" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                <ComboBox x:Name="CmbLanguage" SelectionChanged="CmbLanguage_SelectionChanged">
                                    <ComboBoxItem Content="فارسی (Persian - راست‌چین)"/>
                                    <ComboBoxItem Content="English (Left-to-Right)"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Window Behavior (Toggle Switches) -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtBehaviorTitle" Text="رفتار پنجره و سیستم" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkAlwaysOnTop" Content="نمایش بالاتر از سایر پنجره‌ها (Always on Top)"/>
                                <Separator Background="#263449" Margin="0,4"/>
                                <CheckBox x:Name="ChkLockPosition" Content="قفل کردن موقعیت ویجت روی صفحه (جلوگیری از جابجایی)"/>
                                <Separator Background="#263449" Margin="0,4"/>
                                <CheckBox x:Name="ChkSnapEdges" Content="چسبیدن هوشمند به حاشیه مانیتور هنگام جابجایی"/>
                                <Separator Background="#263449" Margin="0,4"/>
                                <CheckBox x:Name="ChkStartOnBoot" Content="اجرای خودکار هنگام بالا آمدن ویندوز"/>
                            </StackPanel>
                        </Border>

                        <!-- Transparency & Appearance -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtTransparencyTitle" Text="میزان شفافیت و نما" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtLblOpacity" Text="میزان شفافیت ویجت:" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                    <TextBlock x:Name="TxtOpacityValue" Grid.Column="1" Text="92%" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SliderOpacity" Minimum="0.3" Maximum="1.0" Value="0.92" TickFrequency="0.05"
                                        ValueChanged="SliderOpacity_ValueChanged" Margin="0,0,0,12"/>

                                <Separator Background="#263449" Margin="0,4"/>
                                <CheckBox x:Name="ChkCompactDefault" Content="اجرای اولیه در حالت فشرده (Pill)"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Network & Monitoring -->
            <TabItem x:Name="TabNetwork" Header="🌐 شبکه">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtInterfaceTitle" Text="تنظیمات اتصال و کارت شبکه" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                <TextBlock x:Name="TxtLblAdapter" Text="کارت شبکه فعال:" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbAdapters" DisplayMemberPath="Name" Margin="0,0,0,14"/>

                                <TextBlock x:Name="TxtLblSpeedUnit" Text="واحد نمایش سرعت:" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbSpeedUnits" Margin="0,0,0,14">
                                    <ComboBoxItem x:Name="CmbItemBytes" Content="بایت بر ثانیه (B/s, KB/s, MB/s)"/>
                                    <ComboBoxItem x:Name="CmbItemBits" Content="بیت بر ثانیه (bps, Kbps, Mbps)"/>
                                </ComboBox>

                                <TextBlock x:Name="TxtLblInterval" Text="نرخ بروزرسانی سرعت:" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbInterval">
                                    <ComboBoxItem x:Name="CmbItemFast" Content="۵۰۰ میلی‌ثانیه (بسیار سریع و نرم)"/>
                                    <ComboBoxItem x:Name="CmbItemNormal" Content="۱۰۰۰ میلی‌ثانیه (استاندارد - ۱ ثانیه)"/>
                                    <ComboBoxItem x:Name="CmbItemRelaxed" Content="۲۰۰۰ میلی‌ثانیه (مصرف باتری کمتر)"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtPingTitle" Text="سنجش زنده پینگ و تاخیر شبکه" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkEnablePing" Content="فعال بودن سنجش زنده پینگ اینترنت"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtLblPingHost" Text="سرور مقصد پینگ:" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="TxtPingHost" Grid.Column="1" Background="#0F172A" Foreground="#F8FAFC"
                                             BorderBrush="#334155" Padding="8,4" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Usage History -->
            <TabItem x:Name="TabUsage" Header="📊 سوابق مصرف">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Today Card -->
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12,10" BorderBrush="#10B981" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtLblCardToday" Text="امروز" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="TxtCardToday" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 7 Days Card -->
                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="12,10" BorderBrush="#38BDF8" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtLblCard7Days" Text="۷ روز گذشته" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock x:Name="TxtCard7Days" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 30 Days Card -->
                        <Border Grid.Column="4" Background="#1E293B" CornerRadius="8" Padding="12,10" BorderBrush="#A78BFA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtLblCard30Days" Text="۳۰ روز گذشته" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA"/>
                                <TextBlock x:Name="TxtCard30Days" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Data Grid of History -->
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="8" BorderBrush="#334155" BorderThickness="1">
                        <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" RowBackground="#162234" AlternatingRowBackground="#1A273C"
                                  Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                                  BorderThickness="0" HeadersVisibility="Column">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#334155"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColGridDate" Header="تاریخ" Binding="{Binding Date}" Width="120"/>
                                <DataGridTextColumn x:Name="ColGridDown" Header="دانلود" Binding="{Binding DownloadFormatted}" Width="*"/>
                                <DataGridTextColumn x:Name="ColGridUp" Header="آپلود" Binding="{Binding UploadFormatted}" Width="*"/>
                                <DataGridTextColumn x:Name="ColGridTotal" Header="مجموع مصرف" Binding="{Binding TotalFormatted}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: About -->
            <TabItem x:Name="TabAbout" Header="ℹ درباره">
                <Border Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="نت‌متر (NetMetr) v2.0" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtAboutDesc"
                                   Text="نرم‌افزار سبک، مدرن و مینیمال جهت رصد لحظه‌ای سرعت دانلود، آپلود، ترافیک مصرفی روزانه و مدیریت فایروال برنامه‌ها."
                                   Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20"/>
                        <Separator Background="#334155" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtAboutFramework"
                                   Text="توسعه‌یافته با C# .NET 10 و WPF برای ویندوز، و Jetpack Compose برای اندروید."
                                   Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtAboutGithub"
                                   Text="مخزن رسمی: https://github.com/MrSajjadAsadi/NetMetr"
                                   Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnResetTodayStats" Content="صفر کردن آمار امروز" Background="#DC2626" Click="BtnResetToday_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="انصراف" Background="#334155" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="ذخیره و اعمال تنظیمات" Background="#2563EB" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
