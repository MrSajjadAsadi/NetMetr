<Window x:Class="NetMetr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetMetr Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Scrollbars and Tooltips -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <!-- Right-click Context Menu -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="NetMetr Speed Meter" IsEnabled="False" FontWeight="Bold"/>
            <Separator Background="#334155"/>
            <MenuItem x:Name="MenuCompactToggle" Header="Compact Mode" Click="MenuCompactToggle_Click"/>
            <MenuItem x:Name="MenuAlwaysOnTop" Header="Always On Top" IsCheckable="True" IsChecked="True" Click="MenuAlwaysOnTop_Click"/>
            <MenuItem x:Name="MenuLockPosition" Header="Lock Position (No Drag)" IsCheckable="True" Click="MenuLockPosition_Click"/>
            <MenuItem Header="Opacity">
                <MenuItem Header="100%" Click="MenuOpacity_Click" Tag="1.0"/>
                <MenuItem Header="90%" Click="MenuOpacity_Click" Tag="0.9"/>
                <MenuItem Header="75%" Click="MenuOpacity_Click" Tag="0.75"/>
                <MenuItem Header="60%" Click="MenuOpacity_Click" Tag="0.6"/>
                <MenuItem Header="45%" Click="MenuOpacity_Click" Tag="0.45"/>
            </MenuItem>
            <MenuItem Header="Speed Unit">
                <MenuItem Header="Bytes/s (KB/s, MB/s)" Click="MenuUnit_Click" Tag="Bytes"/>
                <MenuItem Header="Bits/s (Kbps, Mbps)" Click="MenuUnit_Click" Tag="Bits"/>
            </MenuItem>
            <Separator Background="#334155"/>
            <MenuItem Header="Settings &amp; History..." Click="MenuSettings_Click"/>
            <MenuItem Header="Reset Today's Stats" Click="MenuResetToday_Click"/>
            <MenuItem Header="Minimize to Tray" Click="MenuMinimizeToTray_Click"/>
            <Separator Background="#334155"/>
            <MenuItem Header="Exit NetMetr" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Main Widget Container with shadow -->
    <Grid Margin="12">
        <Border x:Name="MainBorder"
                CornerRadius="14"
                Background="#EE0F172A"
                BorderBrush="#38BDF8"
                BorderThickness="1.2"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- COMPACT VIEW -->
                <Border x:Name="CompactView" Visibility="Collapsed" Padding="12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Download pill -->
                        <Border Background="#1A10B981" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↓" Foreground="#10B981" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtCompactDown" Text="0.0 KB/s" Foreground="#10B981" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Upload pill -->
                        <Border Background="#1A38BDF8" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↑" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtCompactUp" Text="0.0 KB/s" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Ping pill -->
                        <Border Background="#1AF59E0B" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotCompactPing" Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCompactPing" Text="-- ms" Foreground="#CBD5E1" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Expand button -->
                        <Button Click="BtnToggleCompact_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#94A3B8" Content="▼" FontSize="9"
                                Padding="3" Cursor="Hand" ToolTip="Expand Widget"/>
                    </StackPanel>
                </Border>

                <!-- EXPANDED VIEW -->
                <Border x:Name="ExpandedView" Visibility="Visible" Width="310" Padding="14,10">
                    <StackPanel>
                        <!-- Top Header: Title, Network Type, Ping, Controls -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- App Title & Icon badge -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2563EB" CornerRadius="5" Width="20" Height="20" Margin="0,0,6,0">
                                    <TextBlock Text="⚡" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="NetMetr" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAdapterName" Text="Wi-Fi" Foreground="#94A3B8" FontSize="10"/>
                                </Border>
                            </StackPanel>

                            <!-- Ping and Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Ping Badge -->
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DotPing" Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPing" Text="-- ms" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Settings Button -->
                                <Button Click="MenuSettings_Click" Background="Transparent" BorderThickness="0"
                                        Foreground="#94A3B8" Content="⚙" FontSize="12" Margin="0,0,4,0"
                                        Padding="3" Cursor="Hand" ToolTip="Settings"/>

                                <!-- Minimize/Compact Button -->
                                <Button Click="BtnToggleCompact_Click" Background="Transparent" BorderThickness="0"
                                        Foreground="#94A3B8" Content="▲" FontSize="10"
                                        Padding="3" Cursor="Hand" ToolTip="Compact Mode"/>
                            </StackPanel>
                        </Grid>

                        <!-- Speed Row: Download and Upload Cards -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Download Card -->
                            <Border Grid.Column="0" Background="#132338" CornerRadius="8" Padding="10,8" BorderBrush="#1E3A5F" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="↓ DOWNLOAD" Foreground="#10B981" FontSize="9.5" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtDownSpeed" Text="0.0 KB/s" Foreground="#10B981" FontSize="17" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Upload Card -->
                            <Border Grid.Column="2" Background="#0C253B" CornerRadius="8" Padding="10,8" BorderBrush="#0F4264" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="↑ UPLOAD" Foreground="#38BDF8" FontSize="9.5" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtUpSpeed" Text="0.0 KB/s" Foreground="#38BDF8" FontSize="17" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Real-time Sparkline Graph -->
                        <Border Background="#0B1322" CornerRadius="6" Height="42" Margin="0,0,0,8" ClipToBounds="True">
                            <Canvas x:Name="GraphCanvas" ClipToBounds="True">
                                <Polyline x:Name="PolylineDownload" Stroke="#10B981" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                <Polyline x:Name="PolylineUpload" Stroke="#38BDF8" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Border>

                        <!-- Footer: Today's Total Usage -->
                        <Border Background="#161F30" CornerRadius="6" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="TODAY" Foreground="#A78BFA" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                    <Run Text="↓ " Foreground="#10B981" FontWeight="Bold"/><Run x:Name="TxtTodayDown" Text="0 MB" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                    <Run Text="   ↑ " Foreground="#38BDF8" FontWeight="Bold"/><Run x:Name="TxtTodayUp" Text="0 MB" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                    <Run Text="   (Total: " Foreground="#94A3B8"/><Run x:Name="TxtTodayTotal" Text="0 MB" Foreground="#CBD5E1" FontWeight="Bold"/><Run Text=")" Foreground="#94A3B8"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
